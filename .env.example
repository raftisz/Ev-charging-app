# PostgreSQL. `docker compose up -d db` starts one matching this URL.
# When deploying, paste the database's Internal Connection String here instead.
#
# To share one Postgres instance with another project, append a schema:
#   postgresql://user:pass@host:5432/dbname?schema=voltgrid
# Volt Grid then keeps its tables in their own schema, away from `public`.
DATABASE_URL="postgresql://voltgrid:voltgrid@localhost:5433/voltgrid"

# Signs the session JWTs. Generate a fresh one for any real deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string"

# PromptPay recipient for payment QR codes: a 10-digit phone number, a
# 13-digit national/tax ID or a 15-digit e-wallet ID. Set it in the host's
# environment variables, never in code. Left unset, the app uses
# 000-000-0000, which no bank accepts, so demo QRs cannot move real money.
PROMPTPAY_ID=""
