// Volt Grid — EV charging network schema.
//
// PostgreSQL, so the same schema runs locally (docker compose up -d db)
// and on a hosted Postgres instance. DATABASE_URL selects which.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  OPERATOR
  ADMIN
}

enum StationStatus {
  AVAILABLE
  BUSY
  OFFLINE
  MAINTENANCE
}

enum ChargerStatus {
  AVAILABLE
  CHARGING
  RESERVED
  OFFLINE
  MAINTENANCE
}

enum ConnectorType {
  CCS2
  TYPE2
  CHADEMO
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  STOPPED
  FAULTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  WALLET
  CREDIT_CARD
  PROMPTPAY
}

/// CHARGE settles a charging session, TOPUP adds money to the wallet,
/// REFUND returns a charge to the wallet.
enum PaymentType {
  CHARGE
  TOPUP
  REFUND
}

enum NotificationType {
  SESSION
  RESERVATION
  PAYMENT
  SYSTEM
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(USER)
  avatarInit   String?
  vehicleMake  String?
  vehicleModel String?
  vehiclePlate String?
  batteryKwh   Float?
  walletBalance Float   @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reservations  Reservation[]
  sessions      ChargingSession[]
  notifications Notification[]
  favorites     Favorite[]
  payments      Payment[]
}

model Station {
  id             Int           @id @default(autoincrement())
  name           String
  address        String
  city           String        @default("Bangkok")
  country        String        @default("Thailand")
  latitude       Float
  longitude      Float
  operator       String        @default("Volt Grid")
  status         StationStatus @default(AVAILABLE)
  openingHours   String        @default("24 Hours")
  pricePerKwh    Float
  rating         Float         @default(4.5)
  reviewCount    Int           @default(0)
  amenities      String        @default("")
  imageHue       Int           @default(220)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  chargers     Charger[]
  reservations Reservation[]
  sessions     ChargingSession[]
  favorites    Favorite[]

  @@index([status])
}

model Charger {
  id          Int           @id @default(autoincrement())
  stationId   Int
  chargerCode String
  status      ChargerStatus @default(AVAILABLE)
  powerKw     Float
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  station      Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  connectors   Connector[]
  reservations Reservation[]
  sessions     ChargingSession[]

  @@unique([stationId, chargerCode])
  @@index([status])
}

model Connector {
  id        Int           @id @default(autoincrement())
  chargerId Int
  type      ConnectorType
  powerKw   Float

  charger Charger @relation(fields: [chargerId], references: [id], onDelete: Cascade)
}

model Reservation {
  id        Int               @id @default(autoincrement())
  userId    Int
  stationId Int
  chargerId Int
  startTime DateTime
  endTime   DateTime
  status    ReservationStatus @default(CONFIRMED)
  estimatedKwh Float          @default(0)
  reservationFee Float        @default(20)
  estimatedCost  Float        @default(0)
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  charger Charger          @relation(fields: [chargerId], references: [id], onDelete: Cascade)
  session ChargingSession?

  @@index([userId, status])
  @@index([chargerId, startTime])
  @@index([userId, startTime])
}

model ChargingSession {
  id            Int           @id @default(autoincrement())
  userId        Int
  stationId     Int
  chargerId     Int
  reservationId Int?          @unique
  status        SessionStatus @default(ACTIVE)
  startTime     DateTime      @default(now())
  endTime       DateTime?
  startPercent  Int           @default(20)
  currentPercent Int          @default(20)
  targetPercent Int           @default(80)
  energyKwh     Float         @default(0)
  powerKw       Float         @default(0)
  pricePerKwh   Float
  cost          Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  station     Station      @relation(fields: [stationId], references: [id], onDelete: Cascade)
  charger     Charger      @relation(fields: [chargerId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  payments    Payment[]

  @@index([userId, status])
  @@index([status])
  @@index([userId, startTime])
  @@index([startTime])
}

/// One row per money movement. A top-up has no session. The session link is
/// cleared rather than cascaded when a session is deleted, so the ledger
/// keeps its history.
model Payment {
  id          Int           @id @default(autoincrement())
  sessionId   Int?
  userId      Int
  type        PaymentType   @default(CHARGE)
  amount      Float
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime      @default(now())

  session ChargingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  isRead    Boolean           @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  stationId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
}
