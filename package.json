{
  "name": "ev-charging-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:utc": "TZ=UTC next dev",
    "build": "next build",
    "start": "prisma migrate deploy && tsx prisma/seed.ts --if-empty && next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test:api": "node tests/api.test.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "test:tz": "TZ=UTC tsx tests/timezone.test.ts",
    "test:format": "tsx tests/format.test.ts",
    "test:promptpay": "tsx tests/promptpay.test.ts",
    "test:photos": "tsx tests/station-photos.test.ts",
    "seed:if-empty": "tsx prisma/seed.ts --if-empty",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "start:next": "next start",
    "vercel-build": "prisma migrate deploy && tsx prisma/seed.ts --if-empty && next build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright": "^1.62.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
